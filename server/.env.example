# Server
PORT=
# MongoDB (local, or paste your Atlas connection string)
MONGODB_URI=

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Allowed browser origin(s) for CORS and Socket.IO, comma separated
CLIENT_URL=

# --- Email verification (Resend, https://resend.com) ---
# Leave RESEND_API_KEY empty in development and the verification link is
# printed in the server console instead of being emailed.
RESEND_API_KEY=
# onboarding@resend.dev only delivers to your own Resend account email.
# Verify a domain in Resend, then use e.g. "Study Together <no-reply@yourdomain.com>"
EMAIL_FROM=
# Base URL used in the verification link (defaults to the first CLIENT_URL)
APP_URL=