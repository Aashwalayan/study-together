# Server
PORT=5000

# MongoDB (local, or paste your Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/study-together

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Allowed browser origin(s) for CORS and Socket.IO, comma separated
CLIENT_URL=http://localhost:5173
